# Solana Network RPC (Helius, QuickNode, or Alchemy recommended for mainnet speed)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Agent Private Key (Base58 encoded or JSON array)
AGENT_PRIVATE_KEY=YOUR_BASE58_PRIVATE_KEY

# Treasury Destination Address (EXAMPLE: Destination address receiving 50% fee splits and refund sweeps)
TREASURY_ADDRESS=YOUR_TREASURY_WALLET_ADDRESS_HERE

# Optional Web Event Monitor Integration URL (EXAMPLE: Devved by Jevdev monitor endpoint)
MONITOR_API_URL=https://your-monitor-app.onrender.com
